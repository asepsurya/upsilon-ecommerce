    <style data-purpose="custom-decorations">
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .diagonal-text {
            transform: skew(-5deg);
        }

        .jd-placeholder {
            background-color: #e5e7eb;
            color: #6b7280;
        }
    </style>
</head>

